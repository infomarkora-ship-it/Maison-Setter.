# --- Required ---
DATABASE_URL=postgres://user:pass@localhost:5432/dmsetter
# LLM provider: "anthropic" (production, Claude Haiku) or "gemini" (free-tier testing)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Only needed when LLM_PROVIDER=gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ADMIN_TOKEN=change-me-long-random

# --- Model (override if the model id changes) ---
CLAUDE_MODEL=claude-haiku-5-5
# Used only for the cost log. Check Anthropic pricing and edit if it changes.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50
PRICE_CACHE_READ_PER_MTOK=0.01
PRICE_CACHE_WRITE_PER_MTOK=0.125

# --- Channel platform (InstantDM) ---
# Base URL and paths come from InstantDM's API docs. See src/platform/instantdm.ts
INSTANTDM_BASE_URL=https://api.instantdm.com
# Outbound calls are POST {BASE_URL}{API_PATH} with "Authorization: Bearer <key>".
INSTANTDM_API_PATH=/api-webhook
# Fallback API key for clients whose row has no platform_api_key of their own.
INSTANTDM_API_KEY=
# HMAC-SHA256 secret for the X-Webhook-Signature header. When set, unsigned or badly signed webhooks get 401.
# A per-client secret (clients.instantdm_webhook_secret) overrides this one.
INSTANTDM_WEBHOOK_SECRET=
# Stop automated sends this many minutes before Meta's 24h messaging window closes.
DM_WINDOW_SAFETY_MINUTES=10
PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- Alerts (Slack or Discord incoming-webhook URL) ---
OPERATOR_NOTIFY_WEBHOOK_URL=

# --- Server ---
PORT=3000
